{
  "name": "medevac",
  "version": "3.0.0",
  "description": "MedEvac v3 - Hospital Patient Evacuation Registry + Clinical Decision Support",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "npx serve dist",
    "validate:protocols": "node scripts/validate-protocols.mjs",
    "verify:calculators": "node scripts/verify-calculators.mjs",
    "verify:ocr": "node scripts/verify-ocr.mjs",
    "verify:nfc": "node scripts/verify-nfc.mjs",
    "test": "npm run validate:protocols && npm run verify:calculators && npm run verify:ocr && npm run verify:nfc",
    "cap:init": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "cap:sync": "npm run build && npx cap sync",
    "build:android": "npm run build && npx cap sync android",
    "build:ios": "npm run build && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/ios": "^8.2.0",
    "@capgo/capacitor-nfc": "^8.0.18",
    "idb-keyval": "^6.2.1",
    "onnxruntime-web": "^1.24.3",
    "paddleocr": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
